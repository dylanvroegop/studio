  ],
  "connections": {
    "Elke 5 minuten": {
      "main": [
        [
          {
            "node": "Controleer GPS en stuur appmelding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Amsterdam"
  },
  "active": false
}
