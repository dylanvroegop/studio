    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst invoiceFile = /\\.(pdf|png|jpe?g|webp|heic|heif)$/i;\nreturn items.flatMap((item) => {\n  const text = [item.json.subject, item.json.text, item.json.html, item.json.snippet].filter(Boolean).join(' ').toLowerCase();\n  const binary = item.binary || {};\n  const files = Object.entries(binary).filter(([key, value]) => key.startsWith('attachment_') && invoiceFile.test(value.fileName || key));\n  return files.slice(0, 1).map(([key, value]) => ({ json: { ...item.json, attachmentField: key, attachmentFileName: value.fileName || key, sourceMailbox: 'facturenvroegoptimmerwerken@gmail.com' }, binary: { data: value } }));\n});"
      },
