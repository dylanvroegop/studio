        "jsCode": "const items = $input.all();\nconst invoiceFile = /(?:factuur|invoice|rekening|credit|creditnota|creditfactuur|receipt|bill|nota).*\\.(pdf|png|jpe?g|webp|heic|heif)$/i;\nconst invoiceText = /\\b(factuur|invoice|rekening|creditfactuur|creditnota|vervaldatum|factuurnummer|te betalen|amount due|payment due|btw)\\b/i;\nreturn items.flatMap((item) => {\n  const text = [item.json.subject, item.json.text, item.json.html, item.json.snippet].filter(Boolean).join(' ');\n  const binary = item.binary || {};\n  const files = Object.entries(binary).filter(([key, value]) => {\n    const name = value.fileName || key;\n    return key.startsWith('attachment_') && /\\.(pdf|png|jpe?g|webp|heic|heif)$/i.test(name) && (invoiceFile.test(name) || invoiceText.test(text));\n  });\n  return files.slice(0, 1).map(([key, value]) => ({ json: { ...item.json, attachmentField: key, attachmentFileName: value.fileName || key, sourceMailbox: 'vroegoptimmerwerken@gmail.com' }, binary: { data: value } }));\n});"
