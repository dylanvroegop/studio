{
    "firestore": {
        "rules": "firestore.rules"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "apphosting": [
        {
            "backendId": "studio",
            "rootDir": ".",
            "ignore": [
                "node_modules",
                ".git",
                ".next",
